# Prog Silo Company - Environment Configuration

# LinkedIn Credentials
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password-here

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:latest

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/progsilo
# Or use SQLite for testing:
# DATABASE_URL=sqlite:///progsilo.db

# Company Profile
COMPANY_NAME=Prog Silo Company
COMPANY_TAGLINE=Elevating developers, one insight at a time

# Agent Configuration
MAX_POSTS_PER_DAY=1
MAX_COMMENTS_PER_DAY=30
MIN_COMMENT_QUALITY_SCORE=7
POSTING_TIME=08:00

# Safety Settings
ENABLE_AUTO_POSTING=false
ENABLE_AUTO_COMMENTING=false
DRY_RUN_MODE=true

# Target Audience
TARGET_HASHTAGS=#programming,#softwaredevelopment,#coding,#python,#javascript,#developers
TARGET_FOLLOWER_RANGE_MIN=1000
TARGET_FOLLOWER_RANGE_MAX=50000

# Growth Goals
DAILY_FOLLOWER_TARGET=15
ENGAGEMENT_RATE_TARGET=0.08
